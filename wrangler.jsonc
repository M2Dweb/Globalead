// Configuração do site na Cloudflare (Workers com assets estáticos).
//
// O `npm run build` gera o dist/ e o `npx wrangler deploy` publica-o. Os
// pedidos vão diretamente para os ficheiros do dist/ (fotos, vídeos, assets),
// exceto os caminhos de run_worker_first, que passam primeiro pelo
// server/worker.ts: as páginas com pré-visualização própria para o WhatsApp,
// Facebook e LinkedIn, e as funções da /api.
//
// Segredos (Settings → Variables and Secrets, tipo "Secret"; não ficam aqui):
//   SUPABASE_SERVICE_ROLE_KEY  e  BREVO_API_KEY
{
  "name": "globalead",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Qualquer caminho que não seja um ficheiro devolve o index.html (SPA)
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/sobre",
      "/imoveis",
      "/imoveis/*",
      "/seguros",
      "/credito",
      "/certificacao",
      "/carlos-goncalves",
      "/contactos",
      "/blog/*",
      "/en",
      "/en/*",
      "/api/*",
      "/.netlify/functions/*"
    ]
  },
  // Bucket das fotos e vídeos, para a /api/r2-list
  "r2_buckets": [{ "binding": "R2", "bucket_name": "globalead" }],
  // Valores públicos (já vão no JavaScript do site). Os mesmos estão no
  // .env.production, que é o que a build lê.
  "vars": {
    "VITE_SUPABASE_URL": "https://dzkxlimlbabjstaivuja.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR6a3hsaW1sYmFianN0YWl2dWphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTY5MTY5NDcsImV4cCI6MjA3MjQ5Mjk0N30.XcjrYqc_ZyGLWCJ-4R0nTZNJhtxNgt8nMhGWbA4_S_c",
    "VITE_R2_PUBLIC_BASE_URL": "https://pub-5f573f26090442adbdeb6739a1e97fa9.r2.dev",
    "BREVO_LIST_ID": "5"
  },
  "observability": { "enabled": true }
}
